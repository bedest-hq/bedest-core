{
  "name": "bedest-core",
  "version": "1.0.2",
  "description": "Core abstractions for the BED stack (Bun + Elysia + Drizzle)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.41",
    "elysia": ">=1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "typescript": "^6.0.2"
  }
}
