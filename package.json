{
  "name": "bedest-core",
  "version": "1.1.0",
  "description": "Core abstractions for the BED stack (Bun + Elysia + Drizzle)",
  "keywords": [
    "bun",
    "elysia",
    "drizzle",
    "drizzle-orm",
    "postgres",
    "multi-tenant",
    "row-level-security",
    "crud"
  ],
  "homepage": "https://github.com/bedest-hq/bedest-core#readme",
  "bugs": {
    "url": "https://github.com/bedest-hq/bedest-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedest-hq/bedest-core.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.41",
    "elysia": ">=1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@sinclair/typebox": "^0.34.49",
    "@types/bun": "^1.3.14",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "typescript": "^6.0.3"
  }
}
